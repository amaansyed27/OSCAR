{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OSCAR",
  "version": "0.3.0",
  "identifier": "io.dawnlight.oscar",
  "build": {
    "beforeDevCommand": "node scripts/build-ui.cjs",
    "beforeBuildCommand": "node scripts/build-ui.cjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OSCAR",
        "url": "ui/index.html",
        "dragDropEnabled": false,
        "width": 1280,
        "height": 900,
        "minWidth": 600,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'",
      "capabilities": [
        {
          "identifier": "main",
          "windows": ["main"],
          "permissions": ["core:default", "core:window:allow-close"]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../assets/brand/favicon.ico"]
  }
}
