# OSCAR Slice 01 — local configuration template
# Copy to .env.local only when no private configuration already exists.
# Never overwrite an existing .env/.env.local or commit credentials.

# Current provider: Groq. Use either variable; GROQ_API_KEY takes precedence.
GROQ_API_KEY=
# Alternative: remove the GROQ_API_KEY line above when using this variable.
# GROQ_API_KEY_1=

# Supported defaults. A saved Settings selection overrides the model/budget.
OSCAR_MODEL=openai/gpt-oss-20b
OSCAR_INPUT_TOKENS=16000

# Set these in the launch environment when needed (not in this file):
# OSCAR_CONFIG_DIR: folder containing .env/.env.local.
# OSCAR_DATA_DIR: isolated data folder; default is %APPDATA%/oscar.
# OSCAR_GROQ_ENDPOINT: HTTP-loopback transport-test override only.

# Other providers, key rotation and local model servers are not implemented.
