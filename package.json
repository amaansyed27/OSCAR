{
  "name": "oscar",
  "version": "0.2.0",
  "description": "OSCAR Desktop conversation and local memory",
  "scripts": {
    "start": "tauri dev",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:desktop": "node scripts/build-ui.cjs && cargo build --manifest-path src-tauri/Cargo.toml && node tests/desktop.cjs && node tests/desktop-review.cjs && node tests/desktop-recovery.cjs",
    "test:performance": "cargo run --release --manifest-path src-tauri/Cargo.toml --example performance",
    "test:ui": "node scripts/build-ui.cjs && cargo build --manifest-path src-tauri/Cargo.toml && node tests/ui-motion.cjs",
    "build": "tauri build",
    "ui:build": "node scripts/build-ui.cjs",
    "pretest": "node scripts/build-ui.cjs",
    "pretest:performance": "node scripts/build-ui.cjs",
    "test:release": "node tests/release.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amaansyed27/oscar.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/amaansyed27/oscar/issues"
  },
  "homepage": "https://github.com/amaansyed27/oscar#readme",
  "dependencies": {
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "marked": "^18.1.3",
    "mermaid": "^12.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2.12.4",
    "esbuild": "^0.28.2"
  },
  "private": true
}
